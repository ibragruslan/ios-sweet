+class AppleM2ScalerCSCDriver : public IOService {
+	OSDeclareDefaultStructors(AppleM2ScalerCSCDriver);
+public:
+	virtual bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+};
+OSDefineMetaClassAndStructors(AppleM2ScalerCSCDriver, IOService);
+
+class AppleM2ScalerUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(AppleM2ScalerUserClient);
+public:
+	virtual bool initWithTask(task_t owningTask, void *securityID, UInt32 type) APPLE_KEXT_OVERRIDE {
+		return true;
+	}
+	virtual IOReturn clientClose(void) APPLE_KEXT_OVERRIDE {
+		terminate();
+		return kIOReturnSuccess;
+	}
+	virtual IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+	    IOExternalMethodDispatch *dispatch, OSObject *target,
+	    void *reference) APPLE_KEXT_OVERRIDE {
+		return kIOReturnSuccess;
+	}
+};
+OSDefineMetaClassAndStructors(AppleM2ScalerUserClient, IOUserClient);
+
+bool
+AppleM2ScalerCSCDriver::start(IOService *provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	setProperty(kIOUserClientClassKey, "AppleM2ScalerUserClient");
+	registerService();
+	IOLog("SWEET SCALER: AppleM2ScalerCSCDriver registered\n");
+	return true;
+}
