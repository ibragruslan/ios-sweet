+	out_ring(0x0000002fu);
+	out_ring(0x00000003u);
+	out_ring(0x20000000u);
+	out_ring(0); out_ring(0); out_ring(0); out_ring(0); out_ring(0);
+	rb_flush();
+	if (rb_idle(500)) {
+		printf("SWEET NABU-GPU: CP ME_INIT timeout (hw_rptr=%u wptr=%u status=%#x fault=%#x intr=%#x rbbm_int=%#x fsr=%#x far=%#x)\n",
+		    rd32(GPU_REG(CP_RB_RPTR), 0), s_wptr, rd32(GPU_REG(RBBM_STATUS), 0),
+		    rd32(GPU_REG(CP_HW_FAULT), 0), rd32(GPU_REG(CP_INTERRUPT_STATUS), 0),
+		    rd32(GPU_REG(RBBM_INT_0_STATUS), 0),
+		    s_gpu_smmu.cb ? rd32(s_gpu_smmu.cb + 0x58, 0) : 0,
+		    s_gpu_smmu.cb ? rd32(s_gpu_smmu.cb + 0x60, 0) : 0);
+		return -21;
+	}
+	printf("SWEET NABU-GPU: CP ME_INIT success!\n");
+
+	/* 14. Disable Secure Mode via CP */
+	out_pkt7(CP_SET_SECURE_MODE, 1);
+	out_ring(0);
+	rb_flush();
+	if (rb_idle(500)) {
+		printf("SWEET NABU-GPU: CP SET_SECURE_MODE timeout (hw_rptr=%u wptr=%u status=%#x fault=%#x intr=%#x rbbm_int=%#x fsr=%#x far=%#x)\n",
+		    rd32(GPU_REG(CP_RB_RPTR), 0), s_wptr, rd32(GPU_REG(RBBM_STATUS), 0),
+		    rd32(GPU_REG(CP_HW_FAULT), 0), rd32(GPU_REG(CP_INTERRUPT_STATUS), 0),
+		    rd32(GPU_REG(RBBM_INT_0_STATUS), 0),
+		    s_gpu_smmu.cb ? rd32(s_gpu_smmu.cb + 0x58, 0) : 0,
+		    s_gpu_smmu.cb ? rd32(s_gpu_smmu.cb + 0x60, 0) : 0);
+		return -20;
+	}
+	printf("SWEET NABU-GPU: CP SET_SECURE_MODE success!\n");
+
+	/* 15. Verify CP Memory Write */
+	out_pkt7(CP_MEM_WRITE, 4);
+	out_ring((uint32_t)s_scratch_pa);
+	out_ring((uint32_t)(s_scratch_pa >> 32));
+	out_ring(0xC0FFEE01u);
+	out_ring(0x0DEC0DE5u);
+	rb_flush();
+	if (rb_idle(500)) {
+		printf("SWEET NABU-GPU: CP MEM_WRITE timeout (hw_rptr=%u wptr=%u status=%#x fault=%#x intr=%#x rbbm_int=%#x fsr=%#x far=%#x)\n",
+		    rd32(GPU_REG(CP_RB_RPTR), 0), s_wptr, rd32(GPU_REG(RBBM_STATUS), 0),
+		    rd32(GPU_REG(CP_HW_FAULT), 0), rd32(GPU_REG(CP_INTERRUPT_STATUS), 0),
+		    rd32(GPU_REG(RBBM_INT_0_STATUS), 0),
+		    s_gpu_smmu.cb ? rd32(s_gpu_smmu.cb + 0x58, 0) : 0,
+		    s_gpu_smmu.cb ? rd32(s_gpu_smmu.cb + 0x60, 0) : 0);
+		return -22;
+	}
+	flush_gpu_cache((vm_offset_t)s_scratch, 64);
+	if (s_scratch[0] != 0xC0FFEE01u || s_scratch[1] != 0x0DEC0DE5u) {
+		printf("SWEET NABU-GPU: MEM_WRITE mismatch (%#x %#x)\n", s_scratch[0], s_scratch[1]);
+		return -23;
+	}
+
+	s_gpu_ready = 1;
+	printf("SWEET NABU-GPU: Adreno 640 online, 2D hardware blit & alpha blend ready!\n");
+	return 0;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
