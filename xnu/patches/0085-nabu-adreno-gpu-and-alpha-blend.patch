+		    rd32(GMU_REG(GMU_CM3_DTCM_START + 0x49Du + 5), 0),
+		    rd32(GMU_REG(GMU_CM3_DTCM_START + 0x49Du + 0), 0),
+		    rd32(GMU_REG(GMU_CM3_DTCM_START + 0x49Du + 1), 0),
+		    rd32(GMU_REG(GMU_CM3_DTCM_START + 0x49Du + 2), 0),
+		    rd32(GMU_REG(GMU_CM3_DTCM_START + 0x49Du + 3), 0));
