+/* Register Accessors */
+static inline uint32_t
+rd32(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static inline void
+wr32(vm_offset_t base, uint32_t off, uint32_t val)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = val;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static inline void
+wr64(vm_offset_t base, uint32_t off, uint64_t val)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint64_t *)(base + off) = val;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+#define GMU_REG(dw) (s_gmu + ((uint64_t)(dw) << 2))
+#define RSCC_REG(dw) (s_gmu + 0x23000ULL + ((uint64_t)(dw) << 2))
+#define PDC_REG(dw) (s_pdc + ((uint64_t)(dw) << 2))
+#define PDC_SEQ_REG(dw) (s_pdc_seq + ((uint64_t)(dw) << 2))
+#define GPU_REG(dw) (s_gpu + ((uint64_t)(dw) << 2))
+
+static inline void
+flush_gpu_cache(vm_offset_t va, vm_size_t size)
+{
+	vm_offset_t p;
+	for (p = va & ~63ULL; p < va + size; p += 64) {
+		__asm__ volatile("dc civac, %0" :: "r"(p) : "memory");
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+static int
+poll_bit(vm_offset_t addr, uint32_t mask, uint32_t want, uint32_t ms)
+{
+	uint32_t i;
+	for (i = 0; i <= ms * 100u; ++i) {
+		if ((rd32(addr, 0) & mask) == want) return 0;
+		delay(10);
+	}
+	return -1;
+}
+
+static int
+branch_on(vm_offset_t base, uint32_t off)
+{
+	wr32(base, off, rd32(base, off) | 1u);
+	return poll_bit(base + off, 1u << 31, 0, 5);
+}
