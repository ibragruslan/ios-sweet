+/* ── SCM TrustZone SMC ── */
+#define SMCCC_STD_CALL          0U
+#define SMCCC_SMC64             (1U << 30)
+#define SMCCC_OWNER_SIP         2U
+#define SCM_FN(svc, cmd)        (SMCCC_STD_CALL | SMCCC_SMC64 | (SMCCC_OWNER_SIP << 24) | +                                 (((uint32_t)(svc) & 0xFF) << 8) | ((uint32_t)(cmd) & 0xFF))
+#define SCM_VAL                 0U
+#define SCM_RO                  1U
+#define SCM_RW                  2U
+#define SCM_ARGS_IMPL(n, a, b, c, d, ...) +    ((uint32_t)(n) | ((uint32_t)(a) << 4) | ((uint32_t)(b) << 6) | ((uint32_t)(c) << 8) | ((uint32_t)(d) << 10))
+#define SCM_ARGS(...)           SCM_ARGS_IMPL(__VA_ARGS__, 0, 0, 0, 0)
+
+#define SVC_PIL                 0x02U
+#define PIL_INIT_IMAGE          0x01U
+#define PIL_MEM_SETUP           0x02U
+#define PIL_AUTH_RESET          0x05U
+
+static int64_t
+smc6(uint64_t fn, uint64_t arginfo, const uint64_t a[4], uint64_t out[3])
+{
+	uint64_t session = 0;
+	int busy = 0;
+	for (;;) {
+		register uint64_t x0 __asm__("x0") = fn;
+		register uint64_t x1 __asm__("x1") = arginfo;
+		register uint64_t x2 __asm__("x2") = a[0];
+		register uint64_t x3 __asm__("x3") = a[1];
+		register uint64_t x4 __asm__("x4") = a[2];
+		register uint64_t x5 __asm__("x5") = a[3];
+		register uint64_t x6 __asm__("x6") = session;
+		register uint64_t x7 __asm__("x7") = 0;
+		__asm__ volatile("smc #0"
+		    : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3), "+r"(x4), "+r"(x5), "+r"(x6), "+r"(x7)
+		    :: "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+		if (x0 == 1) { fn = x0; session = x6; continue; }
+		if ((int64_t)x0 == -12 && busy++ < 20) { delay(30000); continue; }
+		if (out) { out[0] = x1; out[1] = x2; out[2] = x3; }
+		return (int64_t)x0;
+	}
+}
