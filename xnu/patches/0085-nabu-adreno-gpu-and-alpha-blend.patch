+	uint32_t *cnoc_addr = &bw[6], *cnoc_data = &bw[12], *ddr_addr = &bw[24], *ddr_data = &bw[32];
+	ddr_addr[0] = 0x50000; ddr_addr[1] = 0x5003c; ddr_addr[2] = 0x5000c;
+	ddr_data[0] = ddr_data[1] = ddr_data[2] = 0x40000000u;
+	cnoc_addr[0] = 0x50034; cnoc_addr[1] = 0x5007c; cnoc_addr[2] = 0x5004c;
+	cnoc_data[0] = 0x40000000u; cnoc_data[1] = 0; cnoc_data[2] = 0x40000000u;
