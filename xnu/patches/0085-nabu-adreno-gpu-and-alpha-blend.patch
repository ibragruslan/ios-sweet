+	void *icache_va = dma_alloc_bytes(240 * 1024, &icache_pa);
+	void *dcache_va = dma_alloc_bytes(512 * 1024, &dcache_pa);
+	void *log_va    = dma_alloc_bytes(16384, &log_pa);
+	void *hfi_va    = dma_alloc_bytes(16384, &hfi_pa);
+	if (!dummy_va || !icache_va || !dcache_va || !log_va || !hfi_va) {
+		printf("SWEET NABU-GPU: GMU buffer allocation failed\n");
+		return -7;
+	}
+
