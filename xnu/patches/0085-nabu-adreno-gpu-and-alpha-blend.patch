+	wr32(GPU_REG(RBBM_SECVID_TSB_TRUSTED_BASE), 0, 0);
+	wr32(GPU_REG(RBBM_SECVID_TSB_TRUSTED_BASE + 1), 0, 0);
+	wr32(GPU_REG(RBBM_SECVID_TSB_TRUSTED_SIZE), 0, 0);
