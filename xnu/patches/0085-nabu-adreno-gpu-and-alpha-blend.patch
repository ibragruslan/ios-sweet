+/* ── SMMU Definitions & Domain Management ── */
+#define IOPTE_TYPE_TABLE        3ULL
+#define IOPTE_TYPE_PAGE         3ULL
+#define IOPTE_ATTR_NC           (0ULL << 2)
+#define IOPTE_ATTR_WB           (1ULL << 2)
+#define IOPTE_SH_IS             (3ULL << 8)
+#define IOPTE_SH_OS             (2ULL << 8)
+#define IOPTE_AP_UNPRIV         (1ULL << 6)
+#define IOPTE_AP_RDONLY         (1ULL << 7)
+#define IOPTE_AF                (1ULL << 10)
+#define IOPTE_NG                (1ULL << 11)
+#define IOPTE_XN                (3ULL << 53)
+#define IOPTE_ADDR_MASK         0x0000FFFFFFFFF000ULL
+
+#define SMMU_CACHED             (1u << 0)
+#define SMMU_PRIV               (1u << 1)
+#define SMMU_EXEC               (1u << 2)
+#define SMMU_RO                 (1u << 3)
+
+typedef struct {
+	vm_offset_t base;
+	vm_offset_t cb;
+	int cbndx;
+	uint64_t *root;
+} SmmuDomain;
+
+static SmmuDomain s_gmu_smmu, s_gpu_smmu;
+
+static void *
+dma_alloc_bytes(uint32_t bytes, uint64_t *pa)
+{
+	void *p;
+	uint32_t aligned = (bytes + 4095u) & ~4095u;
+	if (s_dma_off + aligned > 2 * 1024 * 1024) return NULL;
+	p = (void *)(s_dma_va + s_dma_off);
+	if (pa) *pa = s_dma_pa + s_dma_off;
+	s_dma_off += aligned;
+	bzero(p, aligned);
+	flush_gpu_cache((vm_offset_t)p, aligned);
+	return p;
+}
+
+static uint64_t *
+smmu_pt_alloc(SmmuDomain *d)
+{
+	uint64_t pa = 0;
+	uint64_t *p = (uint64_t *)dma_alloc_bytes(4096, &pa);
+	return p;
+}
+
+static uint64_t *
+smmu_pt_next(SmmuDomain *d, uint64_t *table, int idx)
+{
+	uint64_t e = table[idx];
+	if (e & 1) return (uint64_t *)(s_dma_va + ((e & IOPTE_ADDR_MASK) - s_dma_pa));
+	uint64_t pa = 0;
+	uint64_t *n = (uint64_t *)dma_alloc_bytes(4096, &pa);
+	if (!n) return NULL;
+	table[idx] = pa | IOPTE_TYPE_TABLE;
+	flush_gpu_cache((vm_offset_t)&table[idx], 8);
+	return n;
+}
+
+static int
+smmu_map(SmmuDomain *d, uint64_t iova, uint64_t pa, uint64_t size, uint32_t flags)
+{
+	if (!d->root) {
+		d->root = smmu_pt_alloc(d);
+		if (!d->root) return -1;
+	}
+	uint64_t pte_flags = IOPTE_TYPE_PAGE | IOPTE_AF | IOPTE_NG |
+	    ((flags & SMMU_CACHED) ? (IOPTE_ATTR_WB | IOPTE_SH_IS) : (IOPTE_ATTR_NC | IOPTE_SH_OS));
+	if (!(flags & SMMU_EXEC)) pte_flags |= IOPTE_XN;
+	if (!(flags & SMMU_PRIV)) pte_flags |= IOPTE_AP_UNPRIV;
+	if (flags & SMMU_RO) pte_flags |= IOPTE_AP_RDONLY;
+
+	for (uint64_t off = 0; off < size; off += 4096) {
+		uint64_t va = iova + off;
+		uint64_t *l2 = smmu_pt_next(d, d->root, (int)((va >> 30) & 0x1ff));
+		uint64_t *l3 = l2 ? smmu_pt_next(d, l2, (int)((va >> 21) & 0x1ff)) : NULL;
+		if (!l3) return -2;
+		uint64_t *pte = &l3[(va >> 12) & 0x1ff];
+		*pte = (pa + off) | pte_flags;
+		flush_gpu_cache((vm_offset_t)pte, 8);
+	}
+	if (d->cb) {
+		wr32(d->cb, 0x618, 0); /* CB_TLBIALL */
+		wr32(d->cb, 0x7f0, 0); /* CB_TLBSYNC */
+	}
+	return 0;
+}
+
+static int
+smmu_attach(SmmuDomain *d, uint32_t sid, uint32_t mask, int target_cb)
+{
+	vm_offset_t base = d->base;
+	d->cbndx = target_cb;
+	d->cb = base + 0x8000ULL + (uint64_t)target_cb * 0x1000ULL;
+
+	/* GR1: CBAR & CBA2R */
+	wr32(base, 0x1000u + target_cb * 4, (1u << 16) | (0xfu << 12) | (3u << 8)); /* CBARn: S1 bypass S2, WB, NSH */
+	wr32(base, 0x1800u + target_cb * 4, 1); /* CBA2Rn: VA64 (AArch64 64-bit format) */
+
+	/* SMR & S2CR */
+	int n = target_cb;
+	wr32(base, 0xc00u + n * 4, (0u << 16) | (uint32_t)target_cb); /* S2CR: translation */
+	wr32(base, 0x800u + n * 4, (1u << 31) | (mask << 16) | sid);   /* SMR: valid */
+
+	/* Disable & config CB */
+	wr32(d->cb, 0x000u, 0); /* CB_SCTLR = 0 */
+	wr32(d->cb, 0x004u, 0x303u); /* ACTLR: PREFETCH_DEEP | CPRE | CMTLB */
+	wr32(d->cb, 0x010u, 2u | (1u << 4) | (7u << 15)); /* TCR2: 40-bit PA, 16-bit ASID, SEP=upstream */
+	wr32(d->cb, 0x030u, 25u | (1u << 8) | (1u << 10) | (3u << 12) | (1u << 23)); /* TCR: 39-bit IOVA */
+	uint64_t rpa = s_dma_pa + ((uint64_t)(uintptr_t)d->root - s_dma_va);
+	uint64_t ttbr = rpa | ((uint64_t)target_cb << 48);
+	wr64(d->cb, 0x020u, ttbr);
+	wr64(d->cb, 0x028u, (uint64_t)target_cb << 48);
+	wr32(d->cb, 0x034u, (uint32_t)target_cb);
+	wr32(d->cb, 0x038u, 0x0004FF44u); /* MAIR0 */
+	wr32(d->cb, 0x03Cu, 0);            /* MAIR1 */
+	wr32(d->cb, 0x058u, 0xffffffffu); /* clear FSR */
+	wr32(d->cb, 0x618u, 0);            /* TLBIALL */
+	wr32(d->cb, 0x7f0u, 0);            /* TLBSYNC */
+	wr32(d->cb, 0x000u, 0x1127u);        /* SCTLR: M | TRE | AFE | CFRE | HUPCF | ASIDPNE */
+	return 0;
+}
+
+/* ── RSCC & PDC Sleep/Wake Sequencers ── */
+static void
+rpmh_init(void)
+{
+	wr32(RSCC_REG(RSCC_RSC_STATUS0_DRV0), 0, 1u << 24);
+	wr32(RSCC_REG(RSCC_PDC_SLAVE_ID_DRV0), 0, 1);
+	wr32(RSCC_REG(RSCC_HIDDEN_TCS_CMD0_DATA), 0, 0);
+	wr32(RSCC_REG(RSCC_HIDDEN_TCS_CMD0_ADDR), 0, 0);
+	wr32(RSCC_REG(RSCC_HIDDEN_TCS_CMD0_DATA + 2), 0, 0);
+	wr32(RSCC_REG(RSCC_HIDDEN_TCS_CMD0_ADDR + 2), 0, 0);
+	wr32(RSCC_REG(RSCC_HIDDEN_TCS_CMD0_DATA + 4), 0, 0x80000000u);
+	wr32(RSCC_REG(RSCC_HIDDEN_TCS_CMD0_ADDR + 4), 0, 0);
+	wr32(RSCC_REG(RSCC_OVERRIDE_START_ADDR), 0, 0);
+	wr32(RSCC_REG(RSCC_PDC_SEQ_START_ADDR), 0, 0x4520u);
+	wr32(RSCC_REG(RSCC_PDC_MATCH_VALUE_LO), 0, 0x4510u);
+	wr32(RSCC_REG(RSCC_PDC_MATCH_VALUE_HI), 0, 0x4514u);
+	wr32(RSCC_REG(RSCC_SEQ_MEM_0_DRV0), 0, 0xa7a506a0u);
+	wr32(RSCC_REG(RSCC_SEQ_MEM_0_DRV0 + 1), 0, 0xa1e6a6e7u);
+	wr32(RSCC_REG(RSCC_SEQ_MEM_0_DRV0 + 2), 0, 0xa2e081e1u);
+	wr32(RSCC_REG(RSCC_SEQ_MEM_0_DRV0 + 3), 0, 0xe9a982e2u);
+	wr32(RSCC_REG(RSCC_SEQ_MEM_0_DRV0 + 4), 0, 0x0020e8a8u);
+
+	wr32(PDC_SEQ_REG(0), 0, 0xfebea1e1u);
+	wr32(PDC_SEQ_REG(1), 0, 0xa5a4a3a2u);
+	wr32(PDC_SEQ_REG(2), 0, 0x8382a6e0u);
+	wr32(PDC_SEQ_REG(3), 0, 0xbce3e284u);
+	wr32(PDC_SEQ_REG(4), 0, 0x002081fcu);
+
+	const uint32_t pdc_addr = 0x30090u;
+	wr32(PDC_REG(PDC_GPU_TCS1_CMD_ENABLE_BANK), 0, 7);
+	wr32(PDC_REG(PDC_GPU_TCS1_CMD_WAIT_FOR_CMPL_BANK), 0, 0);
+	wr32(PDC_REG(PDC_GPU_TCS1_CONTROL), 0, 0);
+	wr32(PDC_REG(PDC_GPU_TCS1_CMD0_MSGID), 0, 0x10108u);
+	wr32(PDC_REG(PDC_GPU_TCS1_CMD0_ADDR), 0, 0x30010u);
+	wr32(PDC_REG(PDC_GPU_TCS1_CMD0_DATA), 0, 1);
+	wr32(PDC_REG(PDC_GPU_TCS1_CMD0_MSGID + 4), 0, 0x10108u);
+	wr32(PDC_REG(PDC_GPU_TCS1_CMD0_ADDR + 4), 0, 0x30000u);
+	wr32(PDC_REG(PDC_GPU_TCS1_CMD0_DATA + 4), 0, 0);
+	wr32(PDC_REG(PDC_GPU_TCS1_CMD0_MSGID + 8), 0, 0x10108u);
+	wr32(PDC_REG(PDC_GPU_TCS1_CMD0_ADDR + 8), 0, pdc_addr);
+	wr32(PDC_REG(PDC_GPU_TCS1_CMD0_DATA + 8), 0, 0);
+
+	wr32(PDC_REG(PDC_GPU_TCS3_CMD_ENABLE_BANK), 0, 7);
+	wr32(PDC_REG(PDC_GPU_TCS3_CMD_WAIT_FOR_CMPL_BANK), 0, 0);
+	wr32(PDC_REG(PDC_GPU_TCS3_CONTROL), 0, 0);
+	wr32(PDC_REG(PDC_GPU_TCS3_CMD0_MSGID), 0, 0x10108u);
+	wr32(PDC_REG(PDC_GPU_TCS3_CMD0_ADDR), 0, 0x30010u);
+	wr32(PDC_REG(PDC_GPU_TCS3_CMD0_DATA), 0, 2);
+	wr32(PDC_REG(PDC_GPU_TCS3_CMD0_MSGID + 4), 0, 0x10108u);
+	wr32(PDC_REG(PDC_GPU_TCS3_CMD0_ADDR + 4), 0, 0x30000u);
+	wr32(PDC_REG(PDC_GPU_TCS3_CMD0_DATA + 4), 0, 3);
+	wr32(PDC_REG(PDC_GPU_TCS3_CMD0_MSGID + 8), 0, 0x10108u);
+	wr32(PDC_REG(PDC_GPU_TCS3_CMD0_ADDR + 8), 0, pdc_addr);
+	wr32(PDC_REG(PDC_GPU_TCS3_CMD0_DATA + 8), 0, 3);
+
+	wr32(PDC_REG(PDC_GPU_SEQ_START_ADDR), 0, 0);
+	wr32(PDC_REG(PDC_GPU_ENABLE_PDC), 0, 0x80000001u);
+
+	wr32(GMU_REG(GMU_RSCC_CONTROL_REQ), 0, 1);
+	poll_bit(RSCC_REG(RSCC_RSC_STATUS0_DRV0), 1u << 16, 1u << 16, 10);
+	wr32(GMU_REG(GMU_RSCC_CONTROL_REQ), 0, 0);
+}
+
+static int
+rpmh_start(void)
+{
+	wr32(GMU_REG(GMU_RSCC_CONTROL_REQ), 0, 1u << 1);
+	if (poll_bit(GMU_REG(GMU_RSCC_CONTROL_ACK), 1u << 1, 1u << 1, 10)) return -1;
+	if (poll_bit(RSCC_REG(RSCC_SEQ_BUSY_DRV0), 0xffffffffu, 0, 10)) return -2;
+	wr32(GMU_REG(GMU_RSCC_CONTROL_REQ), 0, 0);
+	return 0;
+}
+
+/* ── GMU Firmware Parser ── */
+typedef struct { uint32_t addr, size, type, value; } FwBlock;
+
+static int
+bo_put(void *virt, uint32_t bo_iova, uint32_t bo_sz, uint32_t addr, const uint8_t *data, uint32_t sz)
+{
+	if (addr < bo_iova || addr + sz > bo_iova + bo_sz) return 0;
+	bcopy(data, (uint8_t *)virt + (addr - bo_iova), sz);
+	flush_gpu_cache((vm_offset_t)((uint8_t *)virt + (addr - bo_iova)), sz);
+	return 1;
+}
+
+static int
+gmu_fw_load(const uint8_t *fw, uint32_t len, void *dummy, void *icache, void *dcache)
+{
+	for (uint32_t o = 0; o + sizeof(FwBlock) <= len;) {
+		const FwBlock *b = (const FwBlock *)(fw + o);
+		const uint8_t *data = fw + o + sizeof(FwBlock);
+		if (o + sizeof(FwBlock) + b->size > len) return -1;
+		o += sizeof(FwBlock) + b->size;
+		if (!b->size) continue;
+
+		if (b->addr < 0x4000u) {
+			for (uint32_t i = 0; i < b->size / 4; ++i) {
+				wr32(GMU_REG(GMU_CM3_ITCM_START + (b->addr >> 2) + i), 0, ((const uint32_t *)data)[i]);
+			}
+		} else if (b->addr >= 0x40000u && b->addr < 0x44000u) {
+			for (uint32_t i = 0; i < b->size / 4; ++i) {
+				wr32(GMU_REG(GMU_CM3_DTCM_START + ((b->addr - 0x40000u) >> 2) + i), 0, ((const uint32_t *)data)[i]);
+			}
+		} else {
+			(void)(bo_put(icache, 0x04000u, 240 * 1024, b->addr, data, b->size) ||
+			       bo_put(dcache, 0x44000u, 512 * 1024, b->addr, data, b->size) ||
+			       bo_put(dummy,  0x60000000u, 4096,   b->addr, data, b->size));
+		}
+	}
+	return 0;
+}
+
+/* ── HFI v2 Communication ── */
+typedef struct { uint32_t version, size, qhdr0_offset, qhdr_size, num_queues, active_queues; } QTable;
+typedef struct {
+	uint32_t status, iova, type, size, msg_size, dropped, rx_watermark, tx_watermark,
+	         rx_request, tx_request, read_index, write_index;
+} QHdr;
+
+#define Q_DWORDS (4096 / 4)
+static uint32_t s_hfi_seq = 0;
+
+static QHdr *
+qhdr(void *hfi_virt, int q)
+{
+	return (QHdr *)((uint8_t *)hfi_virt + sizeof(QTable)) + q;
+}
+
+static uint32_t *
+qdata(void *hfi_virt, int q)
+{
+	return (uint32_t *)((uint8_t *)hfi_virt + 4096 * (q + 1));
+}
+
+static void
+hfi_init(void *hfi_virt, uint32_t hfi_iova)
+{
+	bzero(hfi_virt, 16384);
+	QTable *t = (QTable *)hfi_virt;
+	t->version = 0;
+	t->size = sizeof(QTable) + 3 * sizeof(QHdr);
+	t->qhdr0_offset = sizeof(QTable) >> 2;
+	t->qhdr_size = sizeof(QHdr) >> 2;
+	t->num_queues = t->active_queues = 3;
+	for (int q = 0; q < 3; ++q) {
+		QHdr *h = qhdr(hfi_virt, q);
+		h->iova = hfi_iova + 4096 * (q + 1);
+		h->type = (10u << 8) | (uint32_t)q;
+		h->status = 1;
+		h->size = Q_DWORDS;
+		h->rx_watermark = 1;
+		h->tx_watermark = 1;
+		h->rx_request = 1;
+		h->tx_request = 0;
+	}
+	s_hfi_seq = 0;
+	flush_gpu_cache((vm_offset_t)hfi_virt, 16384);
+}
+
+static int
+hfi_send(void *hfi_virt, uint32_t id, uint32_t *msg, uint32_t bytes)
+{
+	uint32_t dwords = bytes / 4, seq = (++s_hfi_seq) % 0xfffu;
+	msg[0] = (seq << 20) | (dwords << 8) | id;
+
+	flush_gpu_cache((vm_offset_t)hfi_virt, 16384);
+	QHdr *h = qhdr(hfi_virt, 0);
+	uint32_t *d = qdata(hfi_virt, 0);
+	uint32_t wi = h->write_index;
+	for (uint32_t i = 0; i < dwords; ++i) { d[wi] = msg[i]; wi = (wi + 1) % Q_DWORDS; }
+	for (; wi % 4; wi = (wi + 1) % Q_DWORDS) d[wi] = 0xfafafafau;
+	h->write_index = wi;
+	flush_gpu_cache((vm_offset_t)hfi_virt, 16384);
+	wr32(GMU_REG(GMU_HOST2GMU_INTR_SET), 0, 1);
+
+	if (poll_bit(GMU_REG(GMU_GMU2HOST_INTR_INFO), 1u, 1u, 100)) return -1;
+	wr32(GMU_REG(GMU_GMU2HOST_INTR_CLR), 0, 1);
+
+	for (;;) {
+		flush_gpu_cache((vm_offset_t)hfi_virt, 16384);
+		QHdr *rh = qhdr(hfi_virt, 1);
+		uint32_t *rd = qdata(hfi_virt, 1);
+		uint32_t i = rh->read_index;
+		if (i == rh->write_index) return -2;
+		uint32_t r[24], n = (rd[i] >> 8) & 0xffu;
+		if (n == 0 || n > 24) return -3;
+		for (uint32_t k = 0; k < n; ++k) { r[k] = rd[i]; i = (i + 1) % Q_DWORDS; }
+		i = ((i + 3) & ~3u) % Q_DWORDS;
+		rh->read_index = i;
+		flush_gpu_cache((vm_offset_t)hfi_virt, 16384);
+		if ((r[0] & 0xffu) == 100u) continue; /* GMU error */
+		if (n < 3 || ((r[1] >> 20) & 0xfffu) != seq) continue;
+		return r[2] ? -4 : 0;
+	}
+}
+
+/* ── CP Microcode & Ringbuffer ── */
+static uint32_t *s_rb;
+static uint64_t s_rb_pa;
+static uint32_t s_wptr = 0;
+static uint32_t *s_scratch;
+static uint64_t s_scratch_pa;
+static uint32_t *s_rptr_shadow = NULL;
+static uint32_t s_seq = 0;
+
+static inline uint32_t
+pm4_parity(uint32_t v)
+{
+	return (0x9669u >> (0xFu & (v ^ (v >> 4) ^ (v >> 8) ^ (v >> 12) ^ (v >> 16) ^ (v >> 20) ^ (v >> 24) ^ (v >> 28)))) & 1u;
+}
+
+static inline void
+out_ring(uint32_t v)
+{
+	s_rb[s_wptr] = v;
+	s_wptr = (s_wptr + 1) % RB_DWORDS;
+}
+
+static inline void
+out_pkt7(uint32_t op, uint32_t cnt)
+{
+	out_ring(0x70000000u | cnt | (pm4_parity(cnt) << 15) | ((op & 0x7fu) << 16) | (pm4_parity(op) << 23));
+}
+
+static inline void
+out_pkt4(uint32_t reg, uint32_t cnt)
+{
+	out_ring(0x40000000u | cnt | (pm4_parity(cnt) << 7) | ((reg & 0x3ffffu) << 8) | (pm4_parity(reg) << 27));
+}
+
+static void
+rb_flush(void)
+{
+	flush_gpu_cache((vm_offset_t)s_rb, RB_BYTES);
+	wr32(GPU_REG(CP_RB_WPTR), 0, s_wptr);
+}
+
+static int
+rb_idle(uint32_t ms)
+{
+	uint32_t i;
+	for (i = 0; i <= ms * 100u; ++i) {
+		uint32_t hw_rptr = rd32(GPU_REG(CP_RB_RPTR), 0);
+		if ((hw_rptr == s_wptr) &&
+		    !(rd32(GPU_REG(RBBM_STATUS), 0) & ~RBBM_STATUS_CP_AHB_BUSY_CX_MASTER) &&
+		    !(rd32(GPU_REG(RBBM_INT_0_STATUS), 0) & RBBM_INT_HANG_DETECT)) {
+			return 0;
+		}
+		delay(10);
+	}
+	return -1;
+}
+
+static void wfi(void) { out_pkt7(CP_WAIT_FOR_IDLE, 0); }
+
+static void
+event_ts(uint32_t evt)
+{
+	uint64_t a = s_scratch_pa + 64;
+	out_pkt7(CP_EVENT_WRITE, 4);
+	out_ring(evt); out_ring((uint32_t)a); out_ring((uint32_t)(a >> 32)); out_ring(++s_seq);
+}
+
+static void event(uint32_t evt) { out_pkt7(CP_EVENT_WRITE, 1); out_ring(evt); }
+
+int
+nabu_adreno_ready(void)
+{
+	return s_gpu_ready;
+}
+
+int
+nabu_adreno_blit(uint64_t src_pa, uint32_t sx, uint32_t sy, uint32_t sw, uint32_t sh,
+                uint32_t s_pitch, uint32_t s_width, uint32_t s_height,
+                uint64_t dst_pa, uint32_t dx, uint32_t dy, uint32_t dw, uint32_t dh,
+                uint32_t d_pitch, uint32_t d_width, uint32_t d_height, uint32_t layer)
+{
+	if (!s_gpu_ready || !sw || !sh || !dw || !dh) return -1;
+
+	/* Map surfaces into GPU SMMU domain */
+	smmu_map(&s_gpu_smmu, src_pa, src_pa, ((uint64_t)s_pitch * s_height + 4095u) & ~4095u, SMMU_CACHED);
+	smmu_map(&s_gpu_smmu, dst_pa, dst_pa, ((uint64_t)d_pitch * d_height + 4095u) & ~4095u, SMMU_CACHED);
+
+	/* Setup CCU */
+	event_ts(PC_CCU_FLUSH_COLOR_TS);
+	event_ts(PC_CCU_FLUSH_DEPTH_TS);
+	event(PC_CCU_INVALIDATE_COLOR);
+	event(PC_CCU_INVALIDATE_DEPTH);
+	wfi();
+	out_pkt4(RB_CCU_CNTL, 1);
+	out_ring((uint32_t)(CCU_OFFSET_BYPASS >> 12) << 23);
+
+	/* Rects */
+	out_pkt4(GRAS_2D_SRC_TL_X, 4);
+	out_ring(sx << 8); out_ring((sx + sw - 1) << 8);
+	out_ring(sy << 8); out_ring((sy + sh - 1) << 8);
+
+	out_pkt4(GRAS_2D_DST_TL, 2);
+	out_ring((dx & 0x3fffu) | ((dy & 0x3fffu) << 16));
+	out_ring(((dx + dw - 1) & 0x3fffu) | (((dy + dh - 1) & 0x3fffu) << 16));
+
+	/* Format & Controls */
+	uint32_t cntl_v = (0xFu << 20) | (FMT6_8_8_8_8_UNORM << 8) | ((uint32_t)R2D_UNORM8 << 24);
+	out_pkt4(RB_2D_BLIT_CNTL, 1); out_ring(cntl_v);
+	out_pkt4(GRAS_2D_BLIT_CNTL, 1); out_ring(cntl_v);
+	out_pkt4(SP_2D_DST_FORMAT, 1); out_ring(((uint32_t)FMT6_8_8_8_8_UNORM << 3) | (0xFu << 12));
+	out_pkt4(RB_2D_UNKNOWN_8C01, 1); out_ring(0);
+
+	/* Source descriptor */
+	out_pkt4(SP_PS_2D_SRC_INFO, 10);
+	out_ring(FMT6_8_8_8_8_UNORM | (TILE6_LINEAR << 8) | (SWAP_WXYZ << 10) | 0x500000u | (1u << 16));
+	out_ring((s_width & 0x7fffu) | ((s_height & 0x7fffu) << 15));
+	out_ring((uint32_t)src_pa); out_ring((uint32_t)(src_pa >> 32));
+	out_ring((s_pitch >> 6) << 9);
+	for (int i = 0; i < 5; ++i) out_ring(0);
+
+	/* Dest descriptor */
+	out_pkt4(RB_2D_DST_INFO, 9);
+	out_ring(FMT6_8_8_8_8_UNORM | (TILE6_LINEAR << 8) | (SWAP_WXYZ << 10));
+	out_ring((uint32_t)dst_pa); out_ring((uint32_t)(dst_pa >> 32));
+	out_ring(d_pitch >> 6);
+	for (int i = 0; i < 5; ++i) out_ring(0);
+
+	/* Execute blit */
+	event(EVT_BLIT);
+	wfi();
+	out_pkt4(RB_DBG_ECO_CNTL, 1); out_ring(RB_DBG_ECO_CNTL_BLIT);
+	out_pkt7(CP_BLIT, 1); out_ring(BLIT_OP_SCALE);
+	wfi();
+	out_pkt4(RB_DBG_ECO_CNTL, 1); out_ring(0);
+	event_ts(PC_CCU_FLUSH_COLOR_TS);
+	wfi();
+
+	rb_flush();
+	return rb_idle(100);
+}
+
+/* ── Main Bringup Routine ── */
+int
+nabu_adreno_init(void)
+{
+	DTEntry chosen_node;
+	const uint8_t *gmu_fw = NULL, *sqe_fw = NULL, *zap_mdt = NULL, *zap_b02 = NULL;
+	unsigned int gmu_len = 0, sqe_len = 0, mdt_len = 0, b02_len = 0;
+	ppnum_t pn;
+	uint64_t args[4], out_r[3];
+	int e;
+
+	printf("SWEET NABU-GPU: checking Adreno 640 bringup...\n");
+
+	if (SecureDTLookupEntry(NULL, "/chosen", &chosen_node) == kSuccess) {
+		(void)SecureDTGetProperty(chosen_node, "gmu-firmware", (void const **)&gmu_fw, &gmu_len);
+		(void)SecureDTGetProperty(chosen_node, "sqe-firmware", (void const **)&sqe_fw, &sqe_len);
+		(void)SecureDTGetProperty(chosen_node, "zap-mdt", (void const **)&zap_mdt, &mdt_len);
+		(void)SecureDTGetProperty(chosen_node, "zap-b02", (void const **)&zap_b02, &b02_len);
+	}
+
+	if (!gmu_fw || !sqe_fw || !zap_mdt || !zap_b02) {
+		printf("SWEET NABU-GPU: firmware missing in ADT (gmu=%u sqe=%u mdt=%u b02=%u); skipping\n",
+		    gmu_len, sqe_len, mdt_len, b02_len);
+		return -1;
+	}
+
+	/* Map MMIO regions */
+	s_gcc = ml_io_map(GCC_BASE_PA, 0x80000);
+	s_gpucc = ml_io_map(GPUCC_BASE_PA, 0x10000);
+	s_gmu = ml_io_map(GMU_BASE_PA, 0x30000);
+	s_gpu = ml_io_map(GPU_BASE_PA, 0x40000);
+	s_smmu = ml_io_map(ADRENO_SMMU_BASE_PA, 0x10000);
+	s_pdc = ml_io_map(PDC_BASE_PA, 0x10000);
+	s_pdc_seq = ml_io_map(PDC_SEQ_BASE_PA, 0x10000);
+	s_cmddb = ml_io_map(CMD_DB_BASE_PA, 0x10000);
