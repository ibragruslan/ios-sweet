+	static const uint32_t s_gx_votes[7] = { 0, 0x00400000, 0x00800101, 0x00c00202, 0x00e00303, 0x01000404, 0x01400505 };
+	for (int i = 0; i < 7; ++i) {
+		perf[3 + i * 3] = s_gx_votes[i];
+		perf[3 + i * 3 + 1] = 0xffffffffu;
+		perf[3 + i * 3 + 2] = s_gpu_khz[i];
+	}
