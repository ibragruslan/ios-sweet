+
+	/* 1. CX GDSC Power On */
+	wr32(s_gcc, GCC_GPU_CFG_AHB_CBCR, rd32(s_gcc, GCC_GPU_CFG_AHB_CBCR) | 1u);
+	wr32(s_gpucc, GPUCC_CX_GDSCR, rd32(s_gpucc, GPUCC_CX_GDSCR) & ~1u);
