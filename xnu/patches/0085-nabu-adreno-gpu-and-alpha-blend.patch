+	(void)branch_on(s_gcc, GCC_GPU_CFG_AHB_CBCR);
+	(void)branch_on(s_gcc, GCC_GPU_SNOC_DVM_CBCR);
+	(void)branch_on(s_gcc, GCC_GPU_MEMNOC_GFX_CBCR);
+	(void)branch_on(s_gcc, GCC_DDRSS_GPU_AXI_CBCR);
