+static struct {
+	vm_offset_t gcc, tlmm_east, tlmm_north, tlmm_south, se, wrap;
+	bool started, dead;
+	unsigned clk_div, tx_depth, rx_depth;
+	int ax_max, ay_max;
+	uint32_t irq_status, active;
+	int x[NT_MAX], y[NT_MAX];
+} st;
+static int nt_sleep_chan;
+
+static uint32_t
+nt_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+nt_wr(vm_offset_t base, uint32_t off, uint32_t val)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = val;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static void
+nt_set(vm_offset_t base, uint32_t off, uint32_t bits)
+{
+	nt_wr(base, off, nt_rd(base, off) | bits);
+}
+
+static void
+nt_clr(vm_offset_t base, uint32_t off, uint32_t bits)
+{
+	nt_wr(base, off, nt_rd(base, off) & ~bits);
+}
+
+static void
+nt_wait(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&nt_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static bool
+nt_wait_clear(vm_offset_t base, uint32_t off, uint32_t mask)
+{
+	for (unsigned i = 0; i < 5000; ++i) {
+		if (!(nt_rd(base, off) & mask)) {
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+/* TLMM: cfg=(mux<<2 | pull | drive<<6 | oe<<9), io=(out<<1 | in<<0). */
+static void
+nt_gpio(vm_offset_t tile, unsigned pin, unsigned mux, unsigned pull, unsigned drive, unsigned oe)
+{
+	uint32_t off = (uint32_t)pin * 0x1000u;
+	uint32_t cfg = nt_rd(tile, off);
+	cfg &= ~0x3ffu;
+	cfg |= (mux << 2) | pull | (drive << 6) | (oe << 9);
+	nt_wr(tile, off, cfg);
+}
+
+static void
+nt_gpio_set(vm_offset_t tile, unsigned pin, unsigned val)
+{
+	uint32_t off = (uint32_t)pin * 0x1000u + 4u;
+	uint32_t io = nt_rd(tile, off);
+	if (val) {
+		io |= (1u << 1);
+	} else {
+		io &= ~(1u << 1);
+	}
+	nt_wr(tile, off, io);
+}
+
+static bool
+nt_clocks(void)
+{
+	nt_wr(st.gcc, NT_GCC_VOTE, nt_rd(st.gcc, NT_GCC_VOTE) | NT_VOTE_MASK);
+	uint32_t cfg = nt_rd(st.gcc, NT_RCG + 4u);
+	printf("SWEET NABU-TOUCH: vote=%#x rcg=%#x cfg=%#x\n",
+	    nt_rd(st.gcc, NT_GCC_VOTE), nt_rd(st.gcc, NT_RCG), cfg);
+	/* XO source (src 0), divider 1 => 19.2 MHz core clock. */
+	cfg = (cfg & ~(0x371fu | (1u << 20))) | 1u;
+	nt_wr(st.gcc, NT_RCG + 4u, cfg);
+	nt_wr(st.gcc, NT_RCG, nt_rd(st.gcc, NT_RCG) | 1u);
+	if (!nt_wait_clear(st.gcc, NT_RCG, 1u)) {
+		printf("SWEET NABU-TOUCH: RCG update timeout\n");
+		return false;
+	}
+	return true;
+}
+
+/*
+ * Load the GENI SPI serial-engine firmware into SE19's config RAM. Verbatim
+ * order from the mainline SE-FW-load patch; the image is the device's own.
+ * Returns true if the SE afterwards reports the SPI protocol.
+ */
+static bool
+nt_load_fw(void)
+{
+	uint32_t hwver = nt_rd(st.wrap, NT_QUP_HW_VER);
+	const struct nvt_spi_fw *img = NULL;
+	for (unsigned i = 0; i < sizeof(nvt_spi_fw_tbl) / sizeof(nvt_spi_fw_tbl[0]); ++i) {
+		if (nvt_spi_fw_tbl[i].core == hwver) {
+			img = &nvt_spi_fw_tbl[i];
+		}
+	}
+	printf("SWEET NABU-TOUCH: qup_hw_ver=%#x -> %s fw\n", hwver,
+	    img ? "matched" : "NO-MATCH");
+	if (!img) {
+		return false;
+	}
+	/* Wrapper common clock-gating. */
+	nt_set(st.wrap, NT_WRAP_COMMON_CFG, FAST_SWITCH_HIGH);
+	nt_set(st.wrap, NT_WRAP_SE_AHB_M_CFG, AHB_M_CLK_CGC_ON);
+	nt_set(st.wrap, NT_WRAP_COMMON_CGC, COMMON_SLV_CGC_ON);
+	/* Prepare SE for RAM programming. */
+	nt_wr(st.se, G_OUTPUT_CTRL, 0);
+	nt_set(st.se, G_CGC_CTRL, PROG_RAM_OFF);
+	nt_wr(st.se, G_CLK_CTRL, 0);
+	nt_clr(st.se, G_CGC_CTRL, PROG_RAM_OFF);
+	nt_set(st.se, G_DMA_GEN_CFG, DMA_CGC_ON);
+	nt_wr(st.se, G_CGC_CTRL, DEFAULT_CGC_EN);
+	nt_wr(st.se, G_INIT_CFG_REV, img->cfgver);
+	nt_wr(st.se, G_S_INIT_CFG_REV, img->cfgver);
+	for (uint32_t i = 0; i < img->cfgcnt; ++i) {
+		nt_wr(st.se, G_CFG_REG0 + (uint32_t)img->cfgidx[i] * 4u, img->cfgval[i]);
+	}
+	nt_wr(st.se, G_RX_RFR_WM, st.rx_depth > 2 ? st.rx_depth - 2u : 0u);
+	nt_wr(st.se, G_OUTPUT_CTRL, DEFAULT_IO_OUT);
+	nt_wr(st.se, G_DMA_MODE_EN, 0);          /* FIFO mode */
+	/* Protocol + version (SPI=1 in bits[15:8], version low byte). */
+	uint32_t rev = (1u << 8) | (img->fwver & 0xffu);
+	nt_wr(st.se, G_FW_REVISION, rev);
+	nt_wr(st.se, G_S_FW_REVISION, rev);
+	/* Copy firmware words into the config RAM. */
+	for (uint32_t i = 0; i < img->fwcnt; ++i) {
+		nt_wr(st.se, G_CFG_RAMN + i * 4u, img->fw[i]);
+	}
+	nt_wr(st.se, G_FORCE_DEFAULT, 1);
+	nt_set(st.se, G_CGC_CTRL, PROG_RAM_OFF);
+	nt_set(st.se, G_CLK_CTRL, SER_CLK_SEL);
+	nt_clr(st.se, G_CGC_CTRL, PROG_RAM_OFF);
+	nt_set(st.se, G_DMA_IF_EN, DMA_IF_EN_BIT);
+	nt_clr(st.se, G_FIFO_IF_DIS, FIFO_IF_DISABLE);   /* FIFO mode */
+	uint32_t fw = nt_rd(st.se, G_FW_REV);
+	printf("SWEET NABU-TOUCH: after load fw=%#x proto=%u (want 1)\n",
+	    fw, (fw >> 8) & 0xffu);
+	return ((fw >> 8) & 0xffu) == 1u;
+}
+
+static bool
+nt_se_init(void)
+{
+	uint32_t fw = nt_rd(st.se, G_FW_REV);
+	uint32_t proto = (fw >> 8) & 0xffu;
+	printf("SWEET NABU-TOUCH: se fw=%#x proto=%u (1=SPI) status=%#x tx_depth=%u rx_depth=%u\n",
+	    fw, proto, nt_rd(st.se, G_STATUS), st.tx_depth, st.rx_depth);
+	if (proto != 1u) {
+		printf("SWEET NABU-TOUCH: SE18 not SPI after fw load; stop\n");
+		return false;
+	}
+	nt_wr(st.se, G_GSI_EVENT_EN, 0);
+	nt_wr(st.se, G_IRQ_EN, 0);
+	nt_wr(st.se, G_DMA_MODE_EN, 0);
+	nt_wr(st.se, G_M_IRQ_CLR, 0xffffffffu);
+	nt_wr(st.se, G_S_IRQ_CLR, 0xffffffffu);
+	nt_set(st.se, G_CGC_CTRL, DEFAULT_CGC_EN);
+	nt_set(st.se, G_DMA_GEN_CFG, DMA_CGC_ON);
+	nt_wr(st.se, G_OUTPUT_CTRL, DEFAULT_IO_OUT);
+	/* MSB-first packing, four 8-bit words per 32-bit FIFO entry. */
+	nt_wr(st.se, G_BYTE_GRAN, 0);
+	nt_wr(st.se, G_TX_PACK0, 0x0007f8feu);
+	nt_wr(st.se, G_TX_PACK1, 0x000ffefeu);
+	nt_wr(st.se, G_RX_PACK0, 0x0007f8feu);
+	nt_wr(st.se, G_RX_PACK1, 0x000ffefeu);
+	nt_wr(st.se, SPI_WORD_LEN, 8u - 4u);
+	nt_wr(st.se, SPI_CPOL, 0);
+	nt_wr(st.se, SPI_CPHA, 0);
+	nt_wr(st.se, SPI_DEMUX_INV, 0);
+	nt_wr(st.se, SPI_DEMUX_SEL, 0);
+	nt_wr(st.se, SPI_TRANS_CFG, 0);
+	nt_wr(st.se, SPI_PRE_POST_DLY, 0);
+	nt_wr(st.se, G_CLK_SEL, 0);
+	nt_wr(st.se, G_SER_M_CLK_CFG, (st.clk_div << 4) | 1u);
+	nt_wr(st.se, G_M_IRQ_EN,
+	    M_CMD_DONE | M_RX_WATERMARK | M_RX_LAST | M_TX_WATERMARK | M_ERRORS);
+	nt_wr(st.se, G_TX_WATERMARK, 0);
+	return true;
+}
+
+static void
+nt_abort(void)
+{
+	nt_wr(st.se, G_M_CMD_CTRL, M_CMD_ABORT);
+	(void)nt_wait_clear(st.se, G_STATUS, 1u);
+	for (unsigned i = 0; i < 64 && (nt_rd(st.se, G_RX_FIFO_STATUS) & RX_WC_MSK); ++i) {
+		(void)nt_rd(st.se, G_RX_FIFO);
+	}
+	nt_wr(st.se, G_TX_WATERMARK, 0);
+	nt_wr(st.se, G_M_IRQ_CLR, 0xffffffffu);
+}
+
+static int
+nt_cmd(unsigned opcode)
+{
+	nt_wr(st.se, G_M_IRQ_CLR, 0xffffffffu);
+	nt_wr(st.se, G_M_CMD0, opcode << OP_SHIFT);
+	for (unsigned i = 0; i < 5000; ++i) {
+		uint32_t irq = nt_rd(st.se, G_M_IRQ);
+		if (irq & (M_CMD_DONE | M_ERRORS)) {
+			nt_wr(st.se, G_M_IRQ_CLR, irq);
+			return (irq & M_CMD_DONE) ? 0 : EIO;
+		}
+		delay(1);
+	}
+	nt_abort();
+	return ETIMEDOUT;
+}
+
+/* Full-duplex FIFO transfer of n bytes (n <= 96). CS bracketed by M_CMDs. */
+static int
+nt_xfer(const uint8_t *tx, uint8_t *rx, unsigned n)
+{
+	if (st.dead || n == 0 || n > 96) {
+		return EIO;
+	}
+	if (!nt_wait_clear(st.se, G_STATUS, 1u)) {
+		st.dead = true;
+		return EBUSY;
+	}
+	if (nt_cmd(OP_CS_ASSERT)) {
+		st.dead = true;
+		return EIO;
+	}
+	nt_wr(st.se, G_M_IRQ_CLR, 0xffffffffu);
+	nt_wr(st.se, SPI_TX_TRANS_LEN, n);
+	nt_wr(st.se, SPI_RX_TRANS_LEN, n);
+	nt_wr(st.se, G_M_CMD0, ((OP_TX | OP_RX) << OP_SHIFT) | FRAGMENTATION);
+	nt_wr(st.se, G_TX_WATERMARK, 1);
+	unsigned sent = 0, got = 0;
+	int err = ETIMEDOUT;
+	for (unsigned i = 0; i < 50000; ++i) {
+		uint32_t irq = nt_rd(st.se, G_M_IRQ);
+		st.irq_status = irq;
+		if (irq & (M_CMD_FAILURE | (1u << 1) | (1u << 2) | (1u << 4) | (1u << 5))) {
+			err = EIO;
+			break;
+		}
+		if (sent < n && (irq & M_TX_WATERMARK)) {
+			unsigned room = (st.tx_depth - 1u) * 4u;
+			while (sent < n && room) {
+				uint32_t word = 0;
+				for (unsigned j = 0; j < 4u && sent < n; ++j) {
+					word |= (uint32_t)(tx ? tx[sent] : 0) << (8u * j);
+					++sent;
+				}
+				nt_wr(st.se, G_TX_FIFO, word);
+				room -= 4u;
+			}
+			if (sent >= n) {
+				nt_wr(st.se, G_TX_WATERMARK, 0);
+			}
+		}
+		uint32_t count = nt_rd(st.se, G_RX_FIFO_STATUS) & RX_WC_MSK;
+		while (count--) {
+			uint32_t word = nt_rd(st.se, G_RX_FIFO);
+			for (unsigned j = 0; j < 4u && got < n; ++j) {
+				if (rx) {
+					rx[got] = (uint8_t)(word >> (8u * j));
+				}
+				++got;
+			}
+		}
+		if (irq & M_CMD_DONE) {
+			nt_wr(st.se, G_M_IRQ_CLR, irq);
+			err = (got >= n && sent >= n) ? 0 : EIO;
+			break;
+		}
+		nt_wr(st.se, G_M_IRQ_CLR, irq & (M_RX_WATERMARK | M_RX_LAST | M_TX_WATERMARK));
+		delay(1);
+	}
+	if (err) {
+		nt_abort();
+	}
+	(void)nt_cmd(OP_CS_DEASSERT);
+	return err;
+}
+
+static int
+nt_set_page(uint32_t addr)
+{
+	uint8_t buf[3] = { NVT_WR(0xffu), (uint8_t)((addr >> 15) & 0xffu),
+	    (uint8_t)((addr >> 7) & 0xffu) };
+	if (st.dead) {
+		return EIO;
+	}
+	if (!nt_wait_clear(st.se, G_STATUS, 1u)) {
+		st.dead = true;
+		return EBUSY;
+	}
+	if (nt_cmd(OP_CS_ASSERT)) {
+		st.dead = true;
+		return EIO;
+	}
+	nt_wr(st.se, G_M_IRQ_CLR, 0xffffffffu);
+	nt_wr(st.se, SPI_TX_TRANS_LEN, sizeof(buf));
+	nt_wr(st.se, G_M_CMD0, (OP_TX << OP_SHIFT) | FRAGMENTATION);
+	nt_wr(st.se, G_TX_WATERMARK, 1);
+	uint32_t word = buf[0] | ((uint32_t)buf[1] << 8) | ((uint32_t)buf[2] << 16);
+	nt_wr(st.se, G_TX_FIFO, word);
+	nt_wr(st.se, G_TX_WATERMARK, 0);
+	int err = ETIMEDOUT;
+	for (unsigned i = 0; i < 20000; ++i) {
+		uint32_t irq = nt_rd(st.se, G_M_IRQ);
+		if (irq & M_ERRORS) {
+			err = EIO;
+			break;
+		}
+		if (irq & M_CMD_DONE) {
+			nt_wr(st.se, G_M_IRQ_CLR, irq);
+			err = 0;
+			break;
+		}
+		delay(1);
+	}
+	if (err) {
+		nt_abort();
+	}
+	(void)nt_cmd(OP_CS_DEASSERT);
+	return err;
+}
+
+static int
+nt_read(uint32_t addr, uint8_t off, uint8_t *data, unsigned len)
+{
+	uint8_t tx[98] = { 0 }, rx[98] = { 0 };
+	unsigned total = len + 1u + NVT_DUMMY;
+	int err;
+	if (len == 0 || total > sizeof(tx)) {
+		return EIO;
+	}
+	if ((err = nt_set_page(addr)) != 0) {
+		return err;
+	}
+	tx[0] = NVT_RD(off);
+	if ((err = nt_xfer(tx, rx, total)) != 0) {
+		return err;
+	}
+	for (unsigned i = 0; i < len; ++i) {
+		data[i] = rx[2u + i];
+	}
+	return 0;
+}
+
+static inline uint32_t
+nt_le32(const uint8_t *p)
+{
+	return (uint32_t)p[0] | ((uint32_t)p[1] << 8) |
+	    ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+
+static int
+nt_write_buf(uint32_t addr, const uint8_t *data, unsigned len)
+{
+	int err = nt_set_page(addr);
+	if (err) {
+		return err;
+	}
+	uint8_t tx[130];
+	if (len + 1u > sizeof(tx)) {
+		return EINVAL;
+	}
+	tx[0] = NVT_WR(addr & 0x7fu);
+	memcpy(tx + 1, data, len);
+	return nt_xfer(tx, NULL, len + 1u);
+}
+
+static int
+nt_write_addr(uint32_t addr, uint8_t val)
+{
+	return nt_write_buf(addr, &val, 1);
+}
+
+static int
+nt_write_sram(uint32_t sram_addr, const uint8_t *data, unsigned size)
+{
+	unsigned off = 0;
+	while (off < size) {
+		uint32_t cur = sram_addr + off;
+		unsigned page_off = cur & 0x7fu;
+		unsigned chunk = 128u - page_off;
+		if (chunk > (size - off)) {
+			chunk = size - off;
+		}
+		int err = nt_write_buf(cur, data + off, chunk);
+		if (err) {
+			return err;
+		}
+		off += chunk;
+	}
+	return 0;
+}
+
+static bool
+nt_download_firmware(const uint8_t *fw, unsigned fw_size)
+{
+	if (fw_size < 0x22000) {
+		printf("SWEET NABU-TOUCH: fw size %u too small\n", fw_size);
+		return false;
+	}
+	uint32_t ilm_bin = nt_le32(fw + 0);
+	uint32_t ilm_sram = nt_le32(fw + 4);
+	uint32_t ilm_size = nt_le32(fw + 8);
+	uint32_t ilm_crc = nt_le32(fw + 0x18);
+
+	uint32_t dlm_bin = nt_le32(fw + 12);
+	uint32_t dlm_sram = nt_le32(fw + 16);
+	uint32_t dlm_size = nt_le32(fw + 20);
+	uint32_t dlm_crc = nt_le32(fw + 0x1c);
+
+	if ((ilm_bin + ilm_size) > fw_size || (dlm_bin + dlm_size) > fw_size) {
+		printf("SWEET NABU-TOUCH: invalid fw offsets\n");
+		return false;
+	}
+
+	printf("SWEET NABU-TOUCH: downloading touch firmware (%u bytes, ILM=%u DLM=%u)...\n",
+	    fw_size, ilm_size + 1u, dlm_size + 1u);
+
+	/* 1. Bootloader reset */
+	nt_write_addr(NT_SWRST_N8_ADDR, 0x69);
+	nt_wait(5);
+	nt_write_addr(NT_SPI_RD_FAST_ADDR, 0x00);
+
+	/* 2. Configure BLD HW CRC bank for ILM and DLM */
+	uint8_t d_ilm[3] = { (uint8_t)(ilm_sram & 0xff), (uint8_t)((ilm_sram >> 8) & 0xff), (uint8_t)((ilm_sram >> 16) & 0xff) };
+	nt_write_buf(NT_ILM_DES_ADDR, d_ilm, sizeof(d_ilm));
+	uint8_t l_ilm[3] = { (uint8_t)(ilm_size & 0xff), (uint8_t)((ilm_size >> 8) & 0xff), (uint8_t)((ilm_size >> 16) & 0x01) };
+	nt_write_buf(NT_ILM_LENGTH_ADDR, l_ilm, sizeof(l_ilm));
+	uint8_t c_ilm[4] = { (uint8_t)(ilm_crc & 0xff), (uint8_t)((ilm_crc >> 8) & 0xff), (uint8_t)((ilm_crc >> 16) & 0xff), (uint8_t)((ilm_crc >> 24) & 0xff) };
+	nt_write_buf(NT_G_ILM_CHECKSUM_ADDR, c_ilm, sizeof(c_ilm));
+
+	uint8_t d_dlm[3] = { (uint8_t)(dlm_sram & 0xff), (uint8_t)((dlm_sram >> 8) & 0xff), (uint8_t)((dlm_sram >> 16) & 0xff) };
+	nt_write_buf(NT_DLM_DES_ADDR, d_dlm, sizeof(d_dlm));
+	uint8_t l_dlm[3] = { (uint8_t)(dlm_size & 0xff), (uint8_t)((dlm_size >> 8) & 0xff), (uint8_t)((dlm_size >> 16) & 0x01) };
+	nt_write_buf(NT_DLM_LENGTH_ADDR, l_dlm, sizeof(l_dlm));
+	uint8_t c_dlm[4] = { (uint8_t)(dlm_crc & 0xff), (uint8_t)((dlm_crc >> 8) & 0xff), (uint8_t)((dlm_crc >> 16) & 0xff), (uint8_t)((dlm_crc >> 24) & 0xff) };
+	nt_write_buf(NT_G_DLM_CHECKSUM_ADDR, c_dlm, sizeof(c_dlm));
+
+	/* 3. Enable Cascade TX Auto Copy Mode */
+	nt_write_addr(NT_TX_AUTO_COPY_EN, 0x69);
+
+	/* 4. Write firmware sections: ILM, DLM, and cascade header */
+	if (nt_write_sram(ilm_sram, fw + ilm_bin, ilm_size + 1u)) {
+		printf("SWEET NABU-TOUCH: ILM write failed\n");
+		return false;
+	}
+	if (nt_write_sram(dlm_sram, fw + dlm_bin, dlm_size + 1u)) {
+		printf("SWEET NABU-TOUCH: DLM write failed\n");
+		return false;
+	}
+	if (nt_write_sram(0x0002c178u, fw, 256u)) {
+		printf("SWEET NABU-TOUCH: Header write failed\n");
+		return false;
+	}
+
+	/* 5. Poll SPI_DMA_TX_INFO */
+	uint8_t dma_info[1] = { 0xff };
+	for (unsigned i = 0; i < 200; ++i) {
+		if (!nt_read(NT_SPI_DMA_TX_INFO, NT_SPI_DMA_TX_INFO & 0x7fu, dma_info, 1) && dma_info[0] == 0) {
+			break;
+		}
+		nt_wait(1);
+	}
+
+	/* 6. Enable HW BLD CRC */
+	uint8_t bld_crc[1] = { 0 };
+	(void)nt_read(NT_BLD_CRC_EN_ADDR, NT_BLD_CRC_EN_ADDR & 0x7fu, bld_crc, 1);
+	nt_write_addr(NT_BLD_CRC_EN_ADDR, bld_crc[0] | 0x80u);
+
+	/* 7. Clear reset status & enable FW CRC */
+	nt_write_addr(NVT_EVENT_BUF | NT_RESET_COMP_OFF, 0x00);
+	nt_write_addr(NVT_EVENT_BUF | NT_HOST_CMD_OFF, 0xAE);
+
+	/* 8. Boot ready */
+	nt_write_addr(NT_BOOT_RDY_ADDR, 0x01);
+
+	/* 9. Wait for chip to boot into NORMAL_RUN (0xA3) */
+	uint8_t st_buf[6] = { 0 };
+	for (unsigned i = 0; i < 100; ++i) {
+		nt_wait(10);
+		if (!nt_read(NVT_EVENT_BUF, NT_RESET_COMP_OFF, st_buf, sizeof(st_buf))) {
+			if (st_buf[0] >= 0xA0u && st_buf[0] <= 0xA5u) {
+				printf("SWEET NABU-TOUCH: reset state 0x%02x after %u ms\n",
+				    st_buf[0], (i + 1) * 10);
+				return true;
+			}
+		}
+	}
+	printf("SWEET NABU-TOUCH: timed out waiting for reset state (last=0x%02x)\n", st_buf[0]);
+	return false;
+}
+
+static void
+nt_report(uint32_t mask, const int *x, const int *y)
+{
+	for (unsigned id = 0; id < NT_MAX; ++id) {
+		uint32_t bit = 1u << id;
+		if (mask & bit) {
+			if (!(st.active & bit) || x[id] != st.x[id] || y[id] != st.y[id]) {
+				printf("SWEET NABU-TOUCH: TOUCH DOWN f=%u x=%d y=%d\n", id, x[id], y[id]);
+				sweet_hid_touch((int)id, 1, x[id], y[id]);
+			}
+			st.x[id] = x[id];
+			st.y[id] = y[id];
+		} else if (st.active & bit) {
+			printf("SWEET NABU-TOUCH: TOUCH UP f=%u\n", id);
+			sweet_hid_touch((int)id, 0, st.x[id], st.y[id]);
+		}
+	}
+	st.active = mask;
+}
+
+static int
+nt_poll(void)
+{
+	uint8_t d[64];
+	int x[NT_MAX] = { 0 }, y[NT_MAX] = { 0 };
+	uint32_t mask = 0;
+	int err = nt_read(NVT_EVENT_BUF, (uint8_t)(NVT_EVENT_BUF & 0x7fu), d, sizeof(d));
+	if (err) {
+		return err;
+	}
+	bool any = false;
+	for (unsigned i = 0; i < sizeof(d); ++i) {
+		if (d[i] != 0) {
+			any = true;
+			break;
+		}
+	}
+	if (any) {
+		printf("SWEET NABU-TOUCH: raw: %02x %02x %02x %02x %02x %02x %02x %02x\n",
+		    d[0], d[1], d[2], d[3], d[4], d[5], d[6], d[7]);
+	}
+	for (unsigned i = 0; i < NT_MAX; ++i) {
+		const uint8_t *p = d + 6u * i;
+		unsigned id = p[0] >> 3;
+		unsigned status = p[0] & 0x07u;
+		if (id == 0 || id > NT_MAX) {
+			continue;
+		}
+		if (status != 0x01u && status != 0x02u) {
+			continue;
+		}
+		unsigned px = ((unsigned)p[1] << 4) | (p[3] >> 4);
+		unsigned py = ((unsigned)p[2] << 4) | (p[3] & 0x0fu);
+		if ((int)px > st.ax_max || (int)py > st.ay_max) {
+			continue;
+		}
+		unsigned f = id - 1u;
+		mask |= 1u << f;
+		x[f] = (int)(px * NT_HID_X / (unsigned)st.ax_max);
+		y[f] = (int)(py * NT_HID_Y / (unsigned)st.ay_max);
+	}
+	nt_report(mask, x, y);
+	return 0;
+}
+
+static void
+nt_thread(void *arg, wait_result_t result)
+{
+	unsigned delay_s = 45;
+	(void)arg;
+	(void)result;
+	(void)PE_parse_boot_argn("nabutouchdelay", &delay_s, sizeof(delay_s));
+	printf("SWEET NABU-TOUCH: starting in %u s (clk_div=%u)\n", delay_s, st.clk_div);
+	nt_wait(delay_s * 1000u);
+	st.gcc = ml_io_map(NT_GCC_PA, 0x60000);
+	st.tlmm_east = ml_io_map(NT_TLMM_EAST_PA, 0x40000);
+	st.tlmm_north = ml_io_map(NT_TLMM_NORTH_PA, 0x40000);
+	st.tlmm_south = ml_io_map(NT_TLMM_SOUTH_PA, 0x80000);
+	st.se = ml_io_map(NT_SE_PA, 0x4000);
+	st.wrap = ml_io_map(NT_WRAP_PA, 0x1000);
+	if (!st.gcc || !st.tlmm_east || !st.tlmm_north || !st.tlmm_south || !st.se || !st.wrap) {
+		printf("SWEET NABU-TOUCH: MMIO mapping failed\n");
+		goto out;
+	}
+	/* Configure GPIOs first */
+	/* gpio23-26 -> qup18 on EAST tile (MOSI 23 mux 2, MISO 24 mux 3, CLK 25 mux 3, CS_N 26 mux 2) */
+	nt_gpio(st.tlmm_east, 23, 2, 0, 2, 0);
+	nt_gpio(st.tlmm_east, 24, 3, 0, 2, 0);
+	nt_gpio(st.tlmm_east, 25, 3, 0, 2, 0);
+	nt_gpio(st.tlmm_east, 26, 2, 0, 2, 0);
+	/* gpio122 -> pull-up / active rail on SOUTH tile */
+	nt_gpio(st.tlmm_south, 122, 0, 3, 3, 1);
+	nt_gpio_set(st.tlmm_south, 122, 1);
+	/* gpio39 -> IRQ input on NORTH tile */
+	nt_gpio(st.tlmm_north, 39, 0, 1, 4, 0);
+	/* gpio12 -> RESET output on NORTH tile: hold HIGH (do not pulse low unless nabutouchrst=1) */
+	int do_rst = 0;
+	(void)PE_parse_boot_argn("nabutouchrst", &do_rst, sizeof(do_rst));
+	nt_gpio(st.tlmm_north, 12, 0, 0, 1, 1);
+	if (do_rst) {
+		printf("SWEET NABU-TOUCH: pulsing RESET low\n");
+		nt_gpio_set(st.tlmm_north, 12, 0);
+		nt_wait(10);
+	}
+	nt_gpio_set(st.tlmm_north, 12, 1);
+	nt_wait(20);
+	if (!nt_clocks()) {
+		goto out;
+	}
+	uint32_t hw0 = nt_rd(st.se, G_HW_PARAM_0);
+	uint32_t hw1 = nt_rd(st.se, G_HW_PARAM_1);
+	st.tx_depth = (hw0 >> 16) & 0x3fu;
+	st.rx_depth = (hw1 >> 16) & 0x3fu;
+	if (st.tx_depth < 2u || st.tx_depth > 32u) {
+		st.tx_depth = 16u;
+	}
+	if (st.rx_depth < 2u || st.rx_depth > 32u) {
+		st.rx_depth = 16u;
+	}
+	/* If ABL left the I2C firmware (proto!=1), load the SPI SE firmware. */
+	uint32_t proto = (nt_rd(st.se, G_FW_REV) >> 8) & 0xffu;
+	if (proto != 1u) {
+		printf("SWEET NABU-TOUCH: SE18 proto=%u, loading GENI SPI firmware\n", proto);
+		if (!nt_load_fw()) {
+			printf("SWEET NABU-TOUCH: SPI firmware load failed; stop\n");
+			goto out;
+		}
+	}
+	if (!nt_se_init()) {
+		goto out;
+	}
+	nt_wait(20);
+	st.ax_max = 1600;
+	st.ay_max = 2560;
+	uint8_t trim[6] = { 0 };
+	int te = nt_read(0x3f004u, 0x3f004u & 0x7fu, trim, sizeof(trim));
+	printf("SWEET NABU-TOUCH: chip trim err=%d [%02x %02x %02x %02x %02x %02x]\n",
+	    te, trim[0], trim[1], trim[2], trim[3], trim[4], trim[5]);
+	uint8_t rst_state[6] = { 0 };
+	int re = nt_read(NVT_EVENT_BUF, NT_RESET_COMP_OFF, rst_state, sizeof(rst_state));
+	printf("SWEET NABU-TOUCH: rst_state err=%d [%02x %02x %02x %02x %02x %02x] (want 0xA3)\n",
+	    re, rst_state[0], rst_state[1], rst_state[2], rst_state[3], rst_state[4], rst_state[5]);
+
+	const uint8_t *touch_fw = NULL;
+	unsigned int touch_fw_size = 0;
+	DTEntry chosen_node;
+	if (SecureDTLookupEntry(NULL, "/chosen", &chosen_node) == kSuccess) {
+		if (SecureDTGetProperty(chosen_node, "touch-firmware", (void const **)&touch_fw, &touch_fw_size) == kSuccess && touch_fw_size > 0) {
+			printf("SWEET NABU-TOUCH: found touch-firmware in ADT (%u bytes)\n", touch_fw_size);
+		}
+	}
+
+	if (rst_state[0] != 0xA3u) {
+		if (touch_fw && touch_fw_size >= 0x22000) {
+			if (nt_download_firmware(touch_fw, touch_fw_size)) {
+				nt_wait(20);
+				(void)nt_read(NVT_EVENT_BUF, NT_RESET_COMP_OFF, rst_state, sizeof(rst_state));
+				printf("SWEET NABU-TOUCH: after fw load rst_state [%02x %02x %02x %02x %02x %02x]\n",
+				    rst_state[0], rst_state[1], rst_state[2], rst_state[3], rst_state[4], rst_state[5]);
+			}
+		} else {
+			printf("SWEET NABU-TOUCH: rst_state != 0xA3 and no touch-firmware in ADT!\n");
+		}
+	}
+	uint8_t fi[17] = { 0 };
+	int fe = nt_read(NVT_EVENT_BUF, NVT_FWINFO_OFF, fi, sizeof(fi));
+	printf("SWEET NABU-TOUCH: fwinfo err=%d ver=%02x inv=%02x xy=%u,%u res=%u,%u irq=%#x\n",
+	    fe, fi[0], fi[1], fi[2], fi[3],
+	    ((unsigned)fi[4] << 8) | fi[5], ((unsigned)fi[6] << 8) | fi[7], st.irq_status);
+	if (!fe && (uint8_t)(fi[0] + fi[1]) == 0xffu) {
+		unsigned rx = ((unsigned)fi[4] << 8) | fi[5];
+		unsigned ry = ((unsigned)fi[6] << 8) | fi[7];
+		if (rx >= 240 && rx <= 4096 && ry >= 240 && ry <= 4096) {
+			st.ax_max = (int)rx;
+			st.ay_max = (int)ry;
+		}
+		printf("SWEET NABU-TOUCH: firmware live, panel %dx%d\n", st.ax_max, st.ay_max);
+	} else {
+		printf("SWEET NABU-TOUCH: no valid fwinfo; polling anyway (1600x2560)\n");
+	}
+	unsigned errors = 0, pcount = 0;
+	while (!st.dead) {
+		int err = nt_poll();
+		if (err) {
+			if ((errors++ % 200u) == 0) {
+				printf("SWEET NABU-TOUCH: poll err=%d irq=%#x\n", err, st.irq_status);
+			}
+			if (errors == 20) {
+				nt_report(0, st.x, st.y);
+			}
+		} else {
+			errors = 0;
+		}
+		if ((++pcount % 300u) == 0) {
+			uint32_t irq_val = (nt_rd(st.tlmm_north, 39u * 0x1000u + 4u) >> 0) & 1u;
+			printf("SWEET NABU-TOUCH: hb #%u irq_gpio39=%u\n", pcount, irq_val);
+		}
+		nt_wait(10);
+	}
+	printf("SWEET NABU-TOUCH: loop exited! st.dead=%d\n", st.dead);
+	nt_report(0, st.x, st.y);
+out:
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+nabu_touch_init(void)
+{
+	int enabled = 0;
+	int div = 8;
+	thread_t thread;
+	if (st.started) {
+		return;
+	}
+	st.started = true;
+	(void)PE_parse_boot_argn("nabutouch", &enabled, sizeof(enabled));
+	if (!enabled) {
+		return;
+	}
+	(void)PE_parse_boot_argn("nabutouchdiv", &div, sizeof(div));
+	st.clk_div = (div >= 1 && div <= 255) ? (unsigned)div : 8u;
+	kern_return_t kr = kernel_thread_start(nt_thread, NULL, &thread);
+	if (kr == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("SWEET NABU-TOUCH: kernel_thread_start failed %d\n", kr);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
